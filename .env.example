# Copy to `.env` and adjust. Every variable is documented here.

# Postgres connection used by the app and by migrations.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/zaydemy

# Server used by database tests. The test harness creates and drops its own
# databases (`zaydemy_test_*`) on it, so the role needs CREATEDB. Never point
# this at a server holding data you care about.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
