# Copy to `.env` and adjust. Every variable the server reads is listed here.
# Empty means unset. The server validates all of them at startup and stops
# with a list of problems if something is missing or malformed.

# --- App -------------------------------------------------------------------

# Public base URL, without a trailing slash. Required in production.
APP_URL=http://localhost:3010

# Secret for signing tokens (at least 32 characters). Required in production.
# Generate one with: openssl rand -hex 32
APP_SECRET=

# --- Database --------------------------------------------------------------

# Postgres connection used by the app and by migrations.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/zaydemy

# Server used by database tests. The test harness creates and drops its own
# databases (`zaydemy_test_*`) on it, so the role needs CREATEDB. Never point
# this at a server holding data you care about.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# --- Docker Compose --------------------------------------------------------
# Only used by compose.yaml. The app container then connects to the bundled
# Postgres, whatever DATABASE_URL says above.

# Password for the bundled Postgres. Generate one with: openssl rand -hex 24
POSTGRES_PASSWORD=
# Host port for the app (http://localhost:3000). Set APP_URL to match.
APP_PORT=3000

# --- Email -----------------------------------------------------------------
# Sign-in codes are sent by email, so production must choose a transport
# explicitly. `console` prints messages to the server log (development).

# console | smtp | resend  (default in development: console)
EMAIL_TRANSPORT=
# Sender, e.g. "Acme Academy <no-reply@acme.example>". Required for smtp and resend.
EMAIL_FROM=

# SMTP (any provider, Amazon SES SMTP, or a relay).
SMTP_HOST=
SMTP_PORT=587
# true for implicit TLS (usually port 465); otherwise STARTTLS is used when offered.
SMTP_SECURE=false
# Set both or neither.
SMTP_USER=
SMTP_PASSWORD=

# Resend (https://resend.com).
RESEND_API_KEY=

# --- File storage ----------------------------------------------------------

# local | s3  (default: local)
STORAGE_DRIVER=local
# Directory for the local driver; the app serves these files at /api/files.
STORAGE_LOCAL_DIR=./data/uploads

# Any S3-compatible bucket (AWS S3, Cloudflare R2, MinIO). Browsers upload to
# it directly, so the bucket needs a CORS rule allowing PUT from APP_URL.
# Leave S3_ENDPOINT empty for AWS; for R2: https://<account>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL of the bucket's files, without a trailing slash.
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=true

# --- Bot protection --------------------------------------------------------
# Protects public forms (sign-in). If the provider is unreachable, checks are
# skipped rather than locking users out; invalid tokens are always rejected.

# none | turnstile | hcaptcha  (default: none)
BOT_PROTECTION=none
BOT_PROTECTION_SITE_KEY=
BOT_PROTECTION_SECRET_KEY=
